generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  walletAddress    String            @unique @db.VarChar(42)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  auditLogs        AuditLog[]
  encryptedVek     EncryptedVEK?
  guardianOf       Guardian[]        @relation("GuardianWallet")
  guardianCircle   Guardian[]        @relation("GuardianOwner")
  recoveryRequests RecoveryRequest[]
  sessions         Session[]
  trustedDevices   TrustedDevice[]
  vaultEntries     VaultEntry[]

  @@index([walletAddress])
  @@map("users")
}

model EncryptedVEK {
  id           String   @id @default(uuid())
  userId       String   @unique
  encryptedVEK String
  iv           String   @db.VarChar(64)
  tag          String   @db.VarChar(64)
  kdfSalt      String   @db.VarChar(42)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("encrypted_veks")
}

model VaultEntry {
  id         String   @id @default(uuid())
  userId     String
  label      String   @db.VarChar(255)
  username   String   @default("") @db.VarChar(255)
  ciphertext String
  iv         String   @db.VarChar(64)
  tag        String   @db.VarChar(64)
  checksum   String?
  keyFingerprint String? @db.VarChar(32)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, label])
  @@map("vault_entries")
}

model Guardian {
  id              String             @id @default(uuid())
  ownerId         String
  guardianUserId  String?
  guardianAddress String             @db.VarChar(42)
  status          GuardianStatus     @default(PENDING)
  invitationNonce String             @db.VarChar(64)
  encryptedShare  String?
  shareIndex      Int?
  threshold       Int                @default(3)
  createdAt       DateTime           @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?
  expiresAt       DateTime
  txHash          String?            @db.VarChar(66)
  blockNumber     Int?
  contractAddress String?            @db.VarChar(42)
  guardianUser    User?              @relation("GuardianWallet", fields: [guardianUserId], references: [id])
  owner           User               @relation("GuardianOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  approvals       RecoveryApproval[]

  @@index([ownerId])
  @@index([guardianAddress])
  @@index([ownerId, status])
  @@map("guardians")
}

model RecoveryRequest {
  id                String             @id @default(uuid())
  userId            String
  status            RecoveryStatus     @default(PENDING_COOLDOWN)
  challengeNonce    String             @db.VarChar(128)
  threshold         Int
  cooldownExpiresAt DateTime
  requestExpiresAt  DateTime
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime           @default(now())
  txHash            String?            @db.VarChar(66)
  blockNumber       Int?
  contractAddress   String?            @db.VarChar(42)
  approvals         RecoveryApproval[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("recovery_requests")
}

model RecoveryApproval {
  id                String          @id @default(uuid())
  recoveryRequestId String
  guardianId        String
  signature         String
  approvedAt        DateTime        @default(now())
  expiresAt         DateTime
  guardian          Guardian        @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  recoveryRequest   RecoveryRequest @relation(fields: [recoveryRequestId], references: [id], onDelete: Cascade)

  @@unique([recoveryRequestId, guardianId])
  @@index([recoveryRequestId])
  @@map("recovery_approvals")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  eventType   String   @db.VarChar(100)
  metadata    Json     @default("{}")
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?
  createdAt   DateTime @default(now())
  txHash      String?  @db.VarChar(66)
  blockNumber Int?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, eventType])
  @@index([createdAt])
  @@map("audit_logs")
}

model TrustedDevice {
  id                    String    @id @default(uuid())
  userId                String
  deviceFingerprint     String    @db.VarChar(128)
  encryptedRecoveryData String?
  label                 String    @default("Unknown Device") @db.VarChar(100)
  lastUsedAt            DateTime  @default(now())
  createdAt             DateTime  @default(now())
  revokedAt             DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@map("trusted_devices")
}

model Session {
  id              String    @id @default(uuid())
  userId          String
  tokenHash       String    @unique @db.VarChar(64)
  ipAddress       String?   @db.VarChar(45)
  userAgent       String?   @db.VarChar(512)
  deviceLabel     String?   @db.VarChar(100)
  expiresAt       DateTime
  lastRefreshedAt DateTime  @default(now())
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

enum GuardianStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum RecoveryStatus {
  PENDING_COOLDOWN
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}
